                        && request.auth.uid == userId
                        && resource.data.userId == userId
                        && resource.data.paidCents == 0
                        && get(cardPath()).data.userId == userId
                        && get(cardPath()).data.activeStatement.id == statementId
                        && getAfter(cardPath()).data.userId == userId
                        && getAfter(cardPath()).data.get('activeStatement', {}).get('id', '') != statementId
                        && statementMonthOpen(resource.data)
                        && interestLink(resource.data, false)
                      );
      }

      match /payments/{paymentId} {
        function paymentCard(data, creating) {
          let card = get(cardPath()).data;
          return card.userId == userId && getAfter(cardPath()).data.userId == userId
            && data.cardId == cardId
            && (!('statementId' in data)
              ? (data.statementAppliedCents == 0 && (!creating || !('activeStatement' in card)))
              : (data.statementId == card.activeStatement.id
                && get(/databases/$(database)/documents/users/$(userId)/creditCards/$(cardId)/statements/$(data.statementId)).data.cardId == cardId
                && get(/databases/$(database)/documents/users/$(userId)/creditCards/$(cardId)/statements/$(data.statementId)).data.userId == userId));
        }
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && !isDeletingUserData(userId)
                      && request.resource.data.userId == userId
                      && request.resource.data.cardId == cardId
                      && request.resource.data.cardName is string
                      && request.resource.data.cardName.size() > 0
                      && request.resource.data.mode in ['total', 'minimum', 'other']
                      && isIntValue(request.resource.data.amountCents)
                      && request.resource.data.amountCents > 0
                      && nonnegative(request.resource.data.statementAppliedCents)
                      && request.resource.data.statementAppliedCents <= request.resource.data.amountCents
                      && paymentCard(request.resource.data, true)
                      && request.resource.data.paymentDate is string
                      && request.resource.data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                      && request.resource.data.serverDate == request.time;
        allow update: if false;
        allow delete: if request.auth != null
                      && request.auth.uid == userId
                      && (isDeletingUserData(userId)
                        || resource.data.userId == userId && paymentCard(resource.data, false));
      }
    }
    match /users/{userId}/months/{monthId}/movements/{movementId} {
      function closedMonthAdjustment(data) {
        // F5: asiento auditable de ajuste de un mes cerrado. Vive en el mes
        // abierto actual, referencia el mes cerrado y no lo modifica.
        let referencePath = /databases/$(database)/documents/users/$(userId)/months/$(data.get('referenceMonthId', ''));
        return data.get('kind', '') == 'closed_month_adjustment'
          && data.get('referenceMonthId', null) is string
          && data.referenceMonthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && data.referenceMonthId != monthId
          && exists(referencePath) && get(referencePath).data.closed == true
          && data.get('category', null) in ['necesidad', 'ocio', 'ahorro']
          && data.origin == data.category && data.destination == data.category
          && isIntValue(data.get('deltaCents', null)) && data.deltaCents != 0
          && (data.amountCents == data.deltaCents || data.amountCents == -data.deltaCents)
          && data.get('reason', null) is string
          && data.reason.size() > 0 && data.reason.size() <= 200;
      }
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !isDeletingUserData(userId)
                    && !get(/databases/$(database)/documents/users/$(userId)/months/$(monthId)).data.closed
                    && request.resource.data.userId == userId
                    && request.resource.data.monthId == monthId
                    && isIntValue(request.resource.data.amountCents)
                    && request.resource.data.amountCents > 0
                    && request.resource.data.origin in ['necesidad', 'ocio', 'ahorro']
                    && request.resource.data.destination in ['necesidad', 'ocio', 'ahorro']
                    && (
                      (request.resource.data.origin != request.resource.data.destination
                        && request.resource.data.get('kind', 'transfer') == 'transfer')
                      || closedMonthAdjustment(request.resource.data)
                    )
                    && request.resource.data.transactionDate is string
                    && request.resource.data.transactionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.serverDate == request.time
                    && (
                      !('reason' in request.resource.data)
                      || (
                        request.resource.data.reason is string
                        && request.resource.data.reason.size() <= 200
                      )
                    );
      allow update: if false;
      allow delete: if isDeletingUserData(userId);
    }

    match /migrationBackups/{backupId} {
      allow read, delete: if request.auth != null
                          && resource.data.uid == request.auth.uid
                          && isDeletingUserData(request.auth.uid);
      allow create, update: if false;
    }
  }
}
