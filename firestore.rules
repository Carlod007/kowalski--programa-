rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isDeletingUserData(userId) {
      return isOwner(userId)
             && exists(/databases/$(database)/documents/users/$(userId))
             && get(/databases/$(database)/documents/users/$(userId)).data.get('dataDeletionMode', '')
                in ['reset', 'delete-account'];
    }

    match /{document=**} {
      allow read, write: if false;
    }
    match /users/{userId} {
      function currentMarker(monthId) {
        let parts = monthId.split('-');
        let low = request.time - duration.value(3, 'd');
        let high = request.time + duration.value(3, 'd');
        let key = int(parts[0]) * 12 + int(parts[1]);
        return key >= low.year() * 12 + low.month()
          && key <= high.year() * 12 + high.month();
      }
      function validPreviousClosure(previousId) {
        let path = /databases/$(database)/documents/users/$(userId)/months/$(previousId);
        let previous = get(path).data;
        let after = getAfter(path).data;
        let ownedCap = previous.capsCents.ocio - previous.get('borrowedCapsCents', {}).get('ocio', 0);
        let ownedSpent = previous.spentCents.ocio - previous.get('loanFundedSpentCents', {}).get('ocio', 0);
        let remainder = (ownedCap > 0 ? ownedCap : 0) - (ownedSpent > 0 ? ownedSpent : 0);
        return previous.closed == false && after.closed == true
          && after.remainder is map && after.remainder.keys().hasOnly(['ocioToAhorroCents'])
          && after.remainder.ocioToAhorroCents is int && after.remainder.ocioToAhorroCents >= 0
          && after.remainder.ocioToAhorroCents == (remainder > 0 ? remainder : 0);
      }
      function previousMonthProcessed(previousId) {
        let path = /databases/$(database)/documents/users/$(userId)/months/$(previousId);
        return !exists(path) || get(path).data.closed == true || validPreviousClosure(previousId);
      }
      function validLastClosedMonth(data) {
        let previousId = resource.data.get('lastClosedMonth', null);
        let nextId = data.get('lastClosedMonth', null);
        let cleaning = resource.data.get('dataDeletionMode', '') in ['reset', 'delete-account'];
        // Unchanged legacy fields and all other profile fields stay outside this validation.
        return !data.diff(resource.data).affectedKeys().hasAny(['lastClosedMonth'])
          || (data.keys().hasAll(['lastClosedMonth'])
            && (nextId == null
              ? cleaning
              : (!cleaning && nextId is string && nextId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
                && currentMarker(nextId)
                && (previousId == null || (previousId is string
                  && previousId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$') && nextId > previousId))
                && existsAfter(/databases/$(database)/documents/users/$(userId)/months/$(nextId))
                && (previousId == null || previousMonthProcessed(previousId)))));
      }
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.lastClosedMonth == null;
      allow update: if isOwner(userId) && validLastClosedMonth(request.resource.data);
      allow delete: if isOwner(userId)
                    && resource.data.get('dataDeletionMode', '') == 'delete-account';
    }
    match /users/{userId}/months/{monthId} {
      function nonnegative(value) {
        return value is int && value >= 0;
      }
      function pair(value) {
        return value is map && value.keys().hasOnly(['necesidad', 'ocio'])
          && nonnegative(value.necesidad) && nonnegative(value.ocio);
      }
      function percentage(value) {
        return value is map && value.keys().hasOnly(['necesidad', 'ocio', 'ahorro'])
          && nonnegative(value.necesidad) && nonnegative(value.ocio) && nonnegative(value.ahorro)
          && value.necesidad + value.ocio + value.ahorro == 100;
      }
      // UTC +/- 3 days covers UTC-12..UTC+14 plus two days of clock margin.
      function currentMonth() {
        let parts = monthId.split('-');
        let low = request.time - duration.value(3, 'd');
        let high = request.time + duration.value(3, 'd');
        let key = int(parts[0]) * 12 + int(parts[1]);
        return monthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && key >= low.year() * 12 + low.month()
          && key <= high.year() * 12 + high.month();
      }
      function positivePart(value) {
        return value > 0 ? value : 0;
      }
      function borrowedRemainder(data, category) {
        return positivePart(data.get('borrowedCapsCents', {}).get(category, 0)
          - data.get('loanFundedSpentCents', {}).get(category, 0));
      }
      function ownedRemainder(data, category) {
        return positivePart(
          positivePart(data.capsCents[category] - data.get('borrowedCapsCents', {}).get(category, 0))
          - positivePart(data.spentCents[category] - data.get('loanFundedSpentCents', {}).get(category, 0)));
      }
      function inheritedCaps(data) {
        let previousId = get(/databases/$(database)/documents/users/$(userId)).data.lastClosedMonth;
        let previousPath = /databases/$(database)/documents/users/$(userId)/months/$(previousId);
        let previous = get(previousPath).data;
        let after = getAfter(previousPath).data;
        return previousId is string && previousId < monthId
          && previous.closed == false && after.closed == true
          && after.remainder.ocioToAhorroCents == ownedRemainder(previous, 'ocio')
          && data.capsCents.necesidad == ownedRemainder(previous, 'necesidad') + borrowedRemainder(previous, 'necesidad')
          && data.capsCents.ocio == borrowedRemainder(previous, 'ocio')
          && data.borrowedCapsCents.necesidad == borrowedRemainder(previous, 'necesidad')
          && data.borrowedCapsCents.ocio == borrowedRemainder(previous, 'ocio');
      }
      function validNewMonth(data) {
        return currentMonth()
          && data.keys().hasOnly(['totalIncomeCents', 'distribution', 'capsCents', 'spentCents',
            'borrowedCapsCents', 'loanFundedSpentCents', 'ahorroContributedCents', 'incomeCount', 'closed', 'createdAt'])
          && percentage(data.distribution) && pair(data.capsCents) && pair(data.borrowedCapsCents)
          && pair(data.spentCents) && pair(data.loanFundedSpentCents)
          && data.totalIncomeCents is int && data.totalIncomeCents == 0
          && data.incomeCount is int && data.incomeCount == 0
          && data.ahorroContributedCents is int && data.ahorroContributedCents == 0
          && data.spentCents == {'necesidad': 0, 'ocio': 0}
          && data.loanFundedSpentCents == {'necesidad': 0, 'ocio': 0}
          && data.closed == false && data.createdAt == request.time
          && ((data.capsCents == {'necesidad': 0, 'ocio': 0}
              && data.borrowedCapsCents == {'necesidad': 0, 'ocio': 0}) || inheritedCaps(data));
      }
      // Nested diffs preserve untouched legacy entries such as capsCents.ahorro.
      function changedPair(data, field) {
        let next = data[field];
        let changed = next.diff(resource.data.get(field, {})).affectedKeys();
        return next is map && (!(field in resource.data) ? pair(next) : changed.hasOnly(['necesidad', 'ocio']))
          && (!changed.hasAny(['necesidad']) || nonnegative(next.necesidad))
          && (!changed.hasAny(['ocio']) || nonnegative(next.ocio));
      }
      function changedAmounts(data, changed) {
        return (!changed.hasAny(['totalIncomeCents']) || nonnegative(data.totalIncomeCents))
          && (!changed.hasAny(['incomeCount']) || nonnegative(data.incomeCount))
          && (!changed.hasAny(['ahorroContributedCents']) || nonnegative(data.ahorroContributedCents))
          && (!changed.hasAny(['directSavingsCents']) || nonnegative(data.directSavingsCents))
          && (!changed.hasAny(['capsCents']) || changedPair(data, 'capsCents'))
          && (!changed.hasAny(['spentCents']) || changedPair(data, 'spentCents'))
          && (!changed.hasAny(['borrowedCapsCents']) || changedPair(data, 'borrowedCapsCents'))
          && (!changed.hasAny(['loanFundedSpentCents']) || changedPair(data, 'loanFundedSpentCents'));
      }
      function validRemainder(data) {
        return data.remainder is map && data.remainder.keys().hasOnly(['ocioToAhorroCents'])
          && nonnegative(data.remainder.ocioToAhorroCents)
          && data.remainder.ocioToAhorroCents == ownedRemainder(resource.data, 'ocio');
      }
      function validMonthUpdate(data) {
        let changed = data.diff(resource.data).affectedKeys();
        return changed.hasOnly(['distribution', 'totalIncomeCents', 'capsCents', 'spentCents',
            'borrowedCapsCents', 'loanFundedSpentCents', 'ahorroContributedCents',
            'directSavingsCents', 'incomeCount', 'closed', 'remainder'])
          && changedAmounts(data, changed)
          && (!changed.hasAny(['distribution']) || (resource.data.incomeCount == 0 && percentage(data.distribution)))
          && ((resource.data.closed == false
              && ((data.closed == false && !changed.hasAny(['remainder']))
                || (data.closed == true && changed.hasOnly(['closed', 'remainder']) && validRemainder(data))))
            || (resource.data.closed == true && !('remainder' in resource.data)
              && changed.hasOnly(['remainder']) && validRemainder(data)));
      }
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && !isDeletingUserData(userId) && validNewMonth(request.resource.data);
      allow update: if isOwner(userId) && !isDeletingUserData(userId) && validMonthUpdate(request.resource.data);
      allow delete: if isDeletingUserData(userId);
    }
    match /users/{userId}/months/{monthId}/transactions/{txId} {
      function openMonth() {
        let path = /databases/$(database)/documents/users/$(userId)/months/$(monthId);
        return get(path).data.closed == false && getAfter(path).data.closed == false;
      }
      function nonnegative(value) {
        return value is int && value >= 0;
      }
      function text(value, limit) {
        return value is string && value.size() > 0 && value.size() <= limit;
      }
      function optionalText(data, field, limit) {
        return !(field in data) || (data[field] is string && data[field].size() <= limit);
      }
      function validDate(value) {
        let parts = value.split('-');
        let year = int(parts[0]);
        let month = int(parts[1]);
        let day = int(parts[2]);
        let date = timestamp.date(year, month, day);
        let low = request.time - duration.value(3, 'd');
        let high = request.time + duration.value(3, 'd');
        let key = year * 12 + month;
        return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && parts[0] + '-' + parts[1] == monthId
          && date.year() == year && date.month() == month && date.day() == day
          && key >= low.year() * 12 + low.month() && key <= high.year() * 12 + high.month()
          && date <= high;
      }
      function validTags(tags) {
        return tags is list && tags.size() <= 5
          && (tags.size() < 1 || text(tags[0], 24))
          && (tags.size() < 2 || text(tags[1], 24))
          && (tags.size() < 3 || text(tags[2], 24))
          && (tags.size() < 4 || text(tags[3], 24))
          && (tags.size() < 5 || text(tags[4], 24));
      }
      function validSplit(data) {
        let split = data.distribution;
        return split is map && split.keys().hasOnly(['necesidad', 'ocio', 'ahorro'])
          && nonnegative(split.necesidad) && nonnegative(split.ocio) && nonnegative(split.ahorro)
          && split.necesidad + split.ocio + split.ahorro == data.amountCents;
      }
      function newIncomeSplit(data) {
        let percentages = get(/databases/$(database)/documents/users/$(userId)/months/$(monthId)).data.distribution;
        return validSplit(data) && (data.get('isDirectSavings', false)
          ? data.distribution == {'necesidad': 0, 'ocio': 0, 'ahorro': data.amountCents}
          : (data.distribution.necesidad == math.floor(data.amountCents * percentages.necesidad / 100.0)
            && data.distribution.ocio == math.floor(data.amountCents * percentages.ocio / 100.0)));
      }
      function editedIncomeSplit(data) {
        let old = resource.data;
        return validSplit(data) && (old.get('isDirectSavings', false)
          ? data.distribution == {'necesidad': 0, 'ocio': 0, 'ahorro': data.amountCents}
          : (old.amountCents > 0
            && data.distribution.necesidad == math.floor(data.amountCents * (old.distribution.necesidad / float(old.amountCents)))
            && data.distribution.ocio == math.floor(data.amountCents * (old.distribution.ocio / float(old.amountCents)))));
      }
      function pairedText(data, first, second) {
        return (first in data) || (second in data)
          ? text(data.get(first, null), 200) && text(data.get(second, null), 200)
          : true;
      }
      function loanPath(id) {
        return /databases/$(database)/documents/users/$(userId)/loans/$(id);
      }
      function cardPath(id) {
        return /databases/$(database)/documents/users/$(userId)/creditCards/$(id);
      }
      function cardDelta(data, delta) {
        let path = cardPath(data.creditCardId);
        return getAfter(path).data.currentDebtCents == get(path).data.currentDebtCents + delta
          && getAfter(path).data.currentDebtCents >= 0;
      }
      function unconfirmedCard(data, date) {
        let card = get(cardPath(data.creditCardId)).data;
        return data.transactionDate > card.get('lastStatementClosingDate', '')
          && date > card.get('lastStatementClosingDate', '');
      }
      function fundedDelta(data, delta) {
        let path = loanPath(data.fundedByLoanId);
        let old = get(path).data;
        let next = getAfter(path).data;
        let balances = old.get('borrowedAvailableByCategory',
          old.destinationCategory == 'necesidad'
            ? {'necesidad': old.borrowedAvailableCents, 'ocio': 0}
            : {'necesidad': 0, 'ocio': old.borrowedAvailableCents});
        let other = data.category == 'necesidad' ? 'ocio' : 'necesidad';
        // Spending can consume the shared fund across both categories. Reversal
        // restores to the expense category, as transactionService does.
        let selected = balances[data.category] + delta;
        let overflow = selected < 0 ? selected : 0;
        return next.borrowedAvailableCents == old.borrowedAvailableCents + delta
          && next.borrowedAvailableByCategory[data.category] == (selected < 0 ? 0 : selected)
          && next.borrowedAvailableByCategory[other] == balances[other] + overflow;
      }
      function newLoanPayment(data) {
        let path = /databases/$(database)/documents/users/$(userId)/loans/$(data.loanId)/payments/$(data.loanPaymentId);
        let payment = getAfter(path).data;
        return !exists(path) && payment.transactionId == txId && payment.monthId == monthId
          && payment.amountCents == data.amountCents && payment.paymentDate == data.transactionDate
          && payment.sourceCategory == data.category;
      }
      function newCardCharge(data) {
        let path = /databases/$(database)/documents/users/$(userId)/creditCards/$(data.creditCardId)/statements/$(data.creditCardStatementId);
        let statement = getAfter(path).data;
        return !exists(path) && statement.interestTransactionId == txId
          && statement.recordedMonthId == monthId && statement.interestChargesCents == data.amountCents;
      }
      function expenseLinks(data) {
        return pairedText(data, 'fundedByLoanId', 'fundedByLoanName')
          && pairedText(data, 'loanId', 'loanPaymentId')
          && pairedText(data, 'creditCardId', 'creditCardName')
          && pairedText(data, 'creditCardStatementId', 'creditCardChargeKind')
          && ('goalId' in data ? (text(data.goalId, 200) && data.category == 'ahorro'
            && !('loanId' in data) && !('fundedByLoanId' in data) && !('creditCardId' in data)) : true)
          && ('fundedByLoanId' in data ? (data.category in ['necesidad', 'ocio']
            && !('loanId' in data) && !('creditCardId' in data)
            && data.transactionDate >= get(loanPath(data.fundedByLoanId)).data.receivedDate
            && fundedDelta(data, -data.amountCents)) : true)
          && ('loanId' in data ? (!('creditCardId' in data) && newLoanPayment(data)) : true)
          && ('creditCardStatementId' in data ? ('creditCardId' in data
            && data.creditCardChargeKind == 'interest-fees' && data.category == 'necesidad' && newCardCharge(data)) : true)
          && ('creditCardId' in data ? (data.category in ['necesidad', 'ocio']
            && cardDelta(data, data.amountCents)
            && (('creditCardStatementId' in data) ? true : unconfirmedCard(data, data.transactionDate))) : true);
      }
      function newLoanReceipt(data) {
        let path = loanPath(data.loanId);
        let loan = getAfter(path).data;
        return !exists(path) && loan.receiptTransactionId == txId && loan.receivedMonthId == monthId
          && loan.amountReceivedCents == data.amountCents && loan.destinationCategory == data.destinationCategory;
      }
      function validNewTransaction(data) {
        let base = ['type', 'amountCents', 'transactionDate', 'serverDate', 'localDate', 'description'];
        return data.amountCents is int && data.amountCents > 0
          && data.serverDate == request.time && validDate(data.transactionDate)
          && data.localDate is string
          && data.localDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$')
          && optionalText(data, 'description', 2000)
          && (data.type == 'income'
              ? (data.keys().hasOnly(base.concat(['source', 'sourceId', 'distribution', 'isDirectSavings']))
              && data.source is string && data.source.size() <= 200 && optionalText(data, 'sourceId', 200)
              && data.get('isDirectSavings', false) is bool && newIncomeSplit(data))
            : data.type == 'expense'
              ? (data.keys().hasOnly(base.concat(['category', 'subcategory', 'paymentMethod', 'goalId',
                'fundedByLoanId', 'fundedByLoanName', 'loanPaymentId', 'loanId', 'creditCardId',
                'creditCardName', 'creditCardStatementId', 'creditCardChargeKind', 'tags']))
              && data.category in ['necesidad', 'ocio', 'ahorro']
              && text(data.subcategory, 200) && text(data.paymentMethod, 200)
              && (!('tags' in data) || validTags(data.tags)) && expenseLinks(data))
            : (data.type == 'loan'
              && data.keys().hasOnly(base.concat(['loanId', 'lender', 'destinationCategory']))
              && text(data.loanId, 200) && optionalText(data, 'lender', 200)
              && data.destinationCategory in ['necesidad', 'ocio'] && newLoanReceipt(data)));
      }
      function editableExpense(data, changed) {
        let old = resource.data;
        return !('creditCardStatementId' in old)
          && (!changed.hasAny(['amountCents']) || (!('fundedByLoanId' in old) && !('loanPaymentId' in old)))
          && (!changed.hasAny(['transactionDate']) || (!('loanPaymentId' in old)
            && (!('fundedByLoanId' in old) || data.transactionDate >= get(loanPath(old.fundedByLoanId)).data.receivedDate)))
          && (!('creditCardId' in old) || (unconfirmedCard(old, data.transactionDate)
            && cardDelta(old, data.amountCents - old.amountCents)));
      }
      function validTransactionUpdate(data) {
        let changed = data.diff(resource.data).affectedKeys();
        return (!changed.hasAny(['amountCents']) || (data.amountCents is int && data.amountCents > 0))
          && (!changed.hasAny(['transactionDate']) || validDate(data.transactionDate))
          && (!changed.hasAny(['description']) || optionalText(data, 'description', 2000))
          && ((resource.data.type == 'income'
              && changed.hasOnly(['amountCents', 'source', 'sourceId', 'distribution', 'description', 'transactionDate'])
              && (!changed.hasAny(['source']) || (data.source is string && data.source.size() <= 200))
              && (!changed.hasAny(['sourceId']) || optionalText(data, 'sourceId', 200))
              && (!changed.hasAny(['amountCents', 'distribution']) || editedIncomeSplit(data)))
            || (resource.data.type == 'expense'
              && changed.hasOnly(['amountCents', 'subcategory', 'paymentMethod', 'description', 'tags', 'transactionDate'])
              && (!changed.hasAny(['subcategory']) || text(data.subcategory, 200))
              && (!changed.hasAny(['paymentMethod']) || text(data.paymentMethod, 200))
              && (!changed.hasAny(['tags']) || !('tags' in data) || validTags(data.tags))
              && editableExpense(data, changed)));
      }
      function reverseLoanReceipt(data) {
        let path = loanPath(data.loanId);
        let loan = get(path).data;
        return loan.receiptTransactionId == txId && loan.receivedMonthId == monthId
          && loan.paidCents == 0 && loan.borrowedAvailableCents == loan.amountReceivedCents
          && !existsAfter(path);
      }
      function reverseLoanPayment(data) {
        let path = /databases/$(database)/documents/users/$(userId)/loans/$(data.loanId)/payments/$(data.loanPaymentId);
        let payment = get(path).data;
        return payment.transactionId == txId && payment.amountCents == data.amountCents
          && payment.monthId == monthId && !existsAfter(path)
          && getAfter(loanPath(data.loanId)).data.paidCents == get(loanPath(data.loanId)).data.paidCents - data.amountCents;
      }
      function reverseCardCharge(data) {
        let path = /databases/$(database)/documents/users/$(userId)/creditCards/$(data.creditCardId)/statements/$(data.creditCardStatementId);
        let statement = get(path).data;
        return statement.interestTransactionId == txId && statement.recordedMonthId == monthId
          && statement.interestChargesCents == data.amountCents && statement.paidCents == 0
          && get(cardPath(data.creditCardId)).data.activeStatement.id == data.creditCardStatementId
          && !existsAfter(path);
      }
      function reversible(data) {
        return (data.type == 'income')
          || (data.type == 'loan' && reverseLoanReceipt(data))
          || (data.type == 'expense'
            && (!('fundedByLoanId' in data) || fundedDelta(data, data.amountCents))
            && (!('loanPaymentId' in data) || reverseLoanPayment(data))
            && (!('creditCardId' in data) || (cardDelta(data, -data.amountCents)
              && (('creditCardStatementId' in data) ? reverseCardCharge(data) : unconfirmedCard(data, data.transactionDate)))));
      }
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && !isDeletingUserData(userId) && openMonth()
        ? validNewTransaction(request.resource.data) : false;
      allow update: if isOwner(userId) && !isDeletingUserData(userId)
        && openMonth() && validTransactionUpdate(request.resource.data);
      allow delete: if isDeletingUserData(userId)
        || (isOwner(userId) && openMonth() && reversible(resource.data));
    }
    match /users/{userId}/goalAllocations/{allocationId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !isDeletingUserData(userId)
                    && request.resource.data.userId == userId
                    && request.resource.data.goalId is string
                    && request.resource.data.goalName is string
                    && request.resource.data.goalName.size() <= 100
                    && request.resource.data.direction in ['assign', 'release']
                    && request.resource.data.amountCents is int
                    && request.resource.data.amountCents > 0
                    && request.resource.data.transactionDate is string
                    && request.resource.data.transactionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.serverDate == request.time;
      allow update: if false;
      allow delete: if isDeletingUserData(userId);
    }
    match /users/{userId}/loans/{loanId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !isDeletingUserData(userId)
                    && request.resource.data.userId == userId
                    && request.resource.data.amountReceivedCents is int
                    && request.resource.data.amountReceivedCents > 0
                    && request.resource.data.totalToRepayCents is int
                    && request.resource.data.totalToRepayCents >= request.resource.data.amountReceivedCents
                    && request.resource.data.scheduleType in ['fixed-known', 'total-known', 'custom']
                    && request.resource.data.get('importedExisting', false) is bool
                    && request.resource.data.borrowedAvailableCents == request.resource.data.amountReceivedCents
                    && request.resource.data.borrowedAvailableByCategory is map
                    && request.resource.data.borrowedAvailableByCategory.necesidad is int
                    && request.resource.data.borrowedAvailableByCategory.ocio is int
                    && request.resource.data.borrowedAvailableByCategory.necesidad >= 0
                    && request.resource.data.borrowedAvailableByCategory.ocio >= 0
                    && request.resource.data.borrowedAvailableByCategory.necesidad
                       + request.resource.data.borrowedAvailableByCategory.ocio
                       == request.resource.data.borrowedAvailableCents
                    && request.resource.data.paidCents == 0
                    && request.resource.data.fundMovementCount == 0
                    && request.resource.data.destinationCategory in ['necesidad', 'ocio']
                    && request.resource.data.receivedDate is string
                    && request.resource.data.receivedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.receivedMonthId is string
                    && request.resource.data.installments is list
                    && request.resource.data.installments.size() > 0
                    && request.resource.data.installments.size() <= 360
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !isDeletingUserData(userId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.amountReceivedCents == resource.data.amountReceivedCents
                    && request.resource.data.totalToRepayCents == resource.data.totalToRepayCents
                    && request.resource.data.get('scheduleType', 'total-known') == resource.data.get('scheduleType', 'total-known')
                    && request.resource.data.get('importedExisting', false) == resource.data.get('importedExisting', false)
                    && request.resource.data.receivedDate == resource.data.receivedDate
                    && request.resource.data.receivedMonthId == resource.data.receivedMonthId
                    && request.resource.data.destinationCategory == resource.data.destinationCategory
                    && request.resource.data.receiptTransactionId == resource.data.receiptTransactionId
                    && request.resource.data.borrowedAvailableCents is int
                    && request.resource.data.borrowedAvailableCents >= 0
                    && request.resource.data.borrowedAvailableCents <= resource.data.amountReceivedCents
                    && request.resource.data.borrowedAvailableByCategory is map
                    && request.resource.data.borrowedAvailableByCategory.necesidad is int
                    && request.resource.data.borrowedAvailableByCategory.ocio is int
                    && request.resource.data.borrowedAvailableByCategory.necesidad >= 0
                    && request.resource.data.borrowedAvailableByCategory.ocio >= 0
                    && request.resource.data.borrowedAvailableByCategory.necesidad
                       + request.resource.data.borrowedAvailableByCategory.ocio
                       == request.resource.data.borrowedAvailableCents
                    && request.resource.data.paidCents is int
                    && request.resource.data.paidCents >= 0
                    && request.resource.data.paidCents <= resource.data.totalToRepayCents
                    && request.resource.data.fundMovementCount is int
                    && request.resource.data.fundMovementCount >= 0
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['installments'])
                      || (request.resource.data.installments is list
                        && request.resource.data.installments.size() > 0
                        && request.resource.data.installments.size() <= 360
                        && request.resource.data.installments.size() == resource.data.installments.size()))
                    && request.resource.data.updatedAt == request.time;
      allow delete: if isDeletingUserData(userId)
                    || (
                      request.auth != null
                      && request.auth.uid == userId
                      && resource.data.userId == userId
                      && resource.data.paidCents == 0
                      && resource.data.borrowedAvailableCents == resource.data.amountReceivedCents
                      && !get(/databases/$(database)/documents/users/$(userId)/months/$(resource.data.receivedMonthId)).data.closed
                    );

      match /payments/{paymentId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && !isDeletingUserData(userId)
                      && request.resource.data.userId == userId
                      && request.resource.data.loanId == loanId
                      && request.resource.data.amountCents is int
                      && request.resource.data.amountCents > 0
                      && request.resource.data.sourceCategory in ['necesidad', 'ocio', 'ahorro']
                      && request.resource.data.paymentDate is string
                      && request.resource.data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                      && request.resource.data.monthId is string
                      && !get(/databases/$(database)/documents/users/$(userId)/months/$(request.resource.data.monthId)).data.closed
                      && request.resource.data.serverDate == request.time;
        allow update: if false;
        allow delete: if request.auth != null
                      && request.auth.uid == userId
                      && (
                        isDeletingUserData(userId)
                        || !get(/databases/$(database)/documents/users/$(userId)/months/$(resource.data.monthId)).data.closed
                      );
      }
      match /fundMovements/{movementId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Legacy records remain readable/removable; current services create none.
        allow create: if false;
        allow update: if false;
        allow delete: if isDeletingUserData(userId)
                      || (
                        request.auth != null
                        && request.auth.uid == userId
                        && get(/databases/$(database)/documents/users/$(userId)/loans/$(loanId)).data.userId == userId
                        && get(/databases/$(database)/documents/users/$(userId)/loans/$(loanId)).data.paidCents == 0
                        && get(/databases/$(database)/documents/users/$(userId)/loans/$(loanId)).data.borrowedAvailableCents
                           == get(/databases/$(database)/documents/users/$(userId)/loans/$(loanId)).data.amountReceivedCents
                        && !get(/databases/$(database)/documents/users/$(userId)/months/$(get(/databases/$(database)/documents/users/$(userId)/loans/$(loanId)).data.receivedMonthId)).data.closed
                        && !existsAfter(/databases/$(database)/documents/users/$(userId)/loans/$(loanId))
                      );
      }
    }
    match /users/{userId}/creditCards/{cardId} {
      function statementDate(value) {
        return value is string
          && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
      }
      function statementSummary(value) {
        return value is map
          && value.keys().hasOnly(['id', 'closingDate', 'dueDate', 'statementBalanceCents',
            'minimumPaymentCents', 'totalPaymentCents', 'paidCents'])
          && value.id is string && value.id.size() > 0 && value.id.size() <= 200
          && statementDate(value.closingDate) && statementDate(value.dueDate)
          && value.statementBalanceCents is int && value.statementBalanceCents > 0
          && value.minimumPaymentCents is int && value.minimumPaymentCents >= 0
          && value.totalPaymentCents is int && value.totalPaymentCents > 0
          && value.minimumPaymentCents <= value.totalPaymentCents
          && value.paidCents is int && value.paidCents >= 0
          && value.paidCents <= value.totalPaymentCents;
      }
      function statementFields(data, changed) {
        // Validate only changed fields on update, preserving untouched legacy data.
        // Both optional fields may be removed when the latest statement is cancelled.
        return (!changed.hasAny(['activeStatement']) || !('activeStatement' in data)
            || statementSummary(data.activeStatement))
          && (!changed.hasAny(['lastStatementClosingDate']) || !('lastStatementClosingDate' in data)
            || statementDate(data.lastStatementClosingDate));
      }
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !isDeletingUserData(userId)
                    && request.resource.data.userId == userId
                    && request.resource.data.issuer is string
                    && request.resource.data.issuer.size() > 0
                    && request.resource.data.issuer.size() <= 100
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.creditLimitCents is int
                    && request.resource.data.creditLimitCents > 0
                    && request.resource.data.currentDebtCents == 0
                    && request.resource.data.closingDay is int
                    && request.resource.data.closingDay >= 1
                    && request.resource.data.closingDay <= 31
                    && request.resource.data.dueDay is int
                    && request.resource.data.dueDay >= 1
                    && request.resource.data.dueDay <= 31
                    && statementFields(request.resource.data, request.resource.data.keys().toSet())
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !isDeletingUserData(userId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.issuer == resource.data.issuer
                    && request.resource.data.name == resource.data.name
                    && request.resource.data.creditLimitCents == resource.data.creditLimitCents
                    && request.resource.data.closingDay == resource.data.closingDay
                    && request.resource.data.dueDay == resource.data.dueDay
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.currentDebtCents is int
                    && request.resource.data.currentDebtCents >= 0
                    && statementFields(request.resource.data, request.resource.data.diff(resource.data).affectedKeys())
                    && request.resource.data.updatedAt == request.time;
      allow delete: if isDeletingUserData(userId)
                    || (
                      request.auth != null
                      && request.auth.uid == userId
                      && resource.data.userId == userId
                      && resource.data.currentDebtCents == 0
                    );

      match /statements/{statementId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && !isDeletingUserData(userId)
                      && request.resource.data.userId == userId
                      && request.resource.data.cardId == cardId
                      && request.resource.data.id == statementId
                      && request.resource.data.cardName is string
                      && request.resource.data.cardName.size() > 0
                      && request.resource.data.closingDate is string
                      && request.resource.data.closingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                      && request.resource.data.dueDate is string
                      && request.resource.data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                      && request.resource.data.statementBalanceCents is int
                      && request.resource.data.statementBalanceCents > 0
                      && request.resource.data.minimumPaymentCents is int
                      && request.resource.data.minimumPaymentCents >= 0
                      && request.resource.data.totalPaymentCents is int
                      && request.resource.data.totalPaymentCents > 0
                      && request.resource.data.minimumPaymentCents <= request.resource.data.totalPaymentCents
                      && request.resource.data.paidCents == 0
                      && request.resource.data.interestChargesCents is int
                      && request.resource.data.interestChargesCents >= 0
                      && request.resource.data.recordedMonthId is string
                      && request.resource.data.recordedMonthId.matches('^[0-9]{4}-[0-9]{2}$')
                      && request.resource.data.createdAt == request.time;
        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && !isDeletingUserData(userId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidCents'])
                      && request.resource.data.paidCents is int
                      && request.resource.data.paidCents >= 0
                      && request.resource.data.paidCents <= resource.data.totalPaymentCents;
        allow delete: if isDeletingUserData(userId)
                      || (
                        request.auth != null
                        && request.auth.uid == userId
                        && resource.data.userId == userId
                        && resource.data.paidCents == 0
                      );
      }

      match /payments/{paymentId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && !isDeletingUserData(userId)
                      && request.resource.data.userId == userId
                      && request.resource.data.cardId == cardId
                      && request.resource.data.cardName is string
                      && request.resource.data.cardName.size() > 0
                      && request.resource.data.mode in ['total', 'minimum', 'other']
                      && request.resource.data.amountCents is int
                      && request.resource.data.amountCents > 0
                      && request.resource.data.statementAppliedCents is int
                      && request.resource.data.statementAppliedCents >= 0
                      && request.resource.data.statementAppliedCents <= request.resource.data.amountCents
                      && request.resource.data.paymentDate is string
                      && request.resource.data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                      && request.resource.data.serverDate == request.time;
        allow update: if false;
        allow delete: if request.auth != null
                      && request.auth.uid == userId
                      && resource.data.userId == userId;
      }
    }
    match /users/{userId}/months/{monthId}/movements/{movementId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !isDeletingUserData(userId)
                    && !get(/databases/$(database)/documents/users/$(userId)/months/$(monthId)).data.closed
                    && request.resource.data.userId == userId
                    && request.resource.data.monthId == monthId
                    && request.resource.data.amountCents is int
                    && request.resource.data.amountCents > 0
                    && request.resource.data.origin in ['necesidad', 'ocio', 'ahorro']
                    && request.resource.data.destination in ['necesidad', 'ocio', 'ahorro']
                    && request.resource.data.origin != request.resource.data.destination
                    && request.resource.data.transactionDate is string
                    && request.resource.data.transactionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.serverDate == request.time
                    && (
                      !('reason' in request.resource.data)
                      || (
                        request.resource.data.reason is string
                        && request.resource.data.reason.size() <= 200
                      )
                    );
      allow update: if false;
      allow delete: if isDeletingUserData(userId);
    }

    match /migrationBackups/{backupId} {
      allow read, delete: if request.auth != null
                          && resource.data.uid == request.auth.uid
                          && isDeletingUserData(request.auth.uid);
      allow create, update: if false;
    }
  }
}
