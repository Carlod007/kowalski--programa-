rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isDeletingUserData(userId) {
      return isOwner(userId)
             && exists(/databases/$(database)/documents/users/$(userId))
             && get(/databases/$(database)/documents/users/$(userId)).data.get('dataDeletionMode', '')
                in ['reset', 'delete-account'];
    }

    function isIntValue(value) {
      return value is int || (value is float && value == math.floor(value));
    }

    function nonnegative(value) {
      return isIntValue(value) && value >= 0;
    }

    function percentage(value) {
      return value is map && value.keys().hasOnly(['necesidad', 'ocio', 'ahorro'])
        && nonnegative(value.necesidad) && nonnegative(value.ocio) && nonnegative(value.ahorro)
        && value.necesidad + value.ocio + value.ahorro == 100;
    }

    function positivePart(value) {
      return value > 0 ? value : 0;
    }

    function borrowedRemainder(data, category) {
      return positivePart(data.get('borrowedCapsCents', {}).get(category, 0)
        - data.get('loanFundedSpentCents', {}).get(category, 0));
    }

    function rawOwnedBase(data, category) {
      return (data.capsCents[category] - data.get('borrowedCapsCents', {}).get(category, 0))
        - (data.spentCents[category] - data.get('loanFundedSpentCents', {}).get(category, 0));
    }

    function rawNec(data) {
      // F5: el déficit arrastrado reduce el disponible propio de Necesidad.
      return rawOwnedBase(data, 'necesidad') - data.get('carriedDeficitCents', 0);
    }

    function legacyOcio(data) {
      return positivePart(rawOwnedBase(data, 'ocio'));
    }

    function legacyNec(data) {
      return positivePart(rawNec(data));
    }

    function validClosureRemainder(rem, prevData) {
      let rNec = rawNec(prevData);
      let rOcio = rawOwnedBase(prevData, 'ocio');
      let nOcio = positivePart(rOcio + (rNec < 0 ? rNec : 0));
      return rem is map
        && 'ocioToAhorroCents' in rem
        && rem.keys().hasOnly(['ocioToAhorroCents', 'necesidadToNextMonthCents', 'netDeficitCents',
          'borrowedNecesidadCents', 'borrowedOcioCents', 'deficitResolution', 'closedAt',
          'coveredBySavingsCents', 'uncoveredDeficitCents', 'necesidadSweptToAhorroCents', 'ocioToNextMonthCents'])
        && nonnegative(rem.ocioToAhorroCents)
        && (rem.keys().hasOnly(['ocioToAhorroCents'])
          ? (rem.ocioToAhorroCents == nOcio || rem.ocioToAhorroCents == positivePart(rOcio))
          : (rem.ocioToAhorroCents + rem.get('ocioToNextMonthCents', 0) == nOcio
            && (!('ocioToNextMonthCents' in rem) || nonnegative(rem.ocioToNextMonthCents))
            && rem.get('necesidadToNextMonthCents', 0) + rem.get('necesidadSweptToAhorroCents', 0) == positivePart(rNec + (rOcio < 0 ? rOcio : 0))
            && (!('necesidadToNextMonthCents' in rem) || nonnegative(rem.necesidadToNextMonthCents))
            && (!('necesidadSweptToAhorroCents' in rem) || nonnegative(rem.necesidadSweptToAhorroCents))
            && (!('netDeficitCents' in rem) || rem.netDeficitCents == positivePart(-(rNec + rOcio)))
            && (!('borrowedNecesidadCents' in rem) || rem.borrowedNecesidadCents == borrowedRemainder(prevData, 'necesidad'))
            && (!('borrowedOcioCents' in rem) || rem.borrowedOcioCents == borrowedRemainder(prevData, 'ocio'))
            && (!('deficitResolution' in rem)
              || rem.deficitResolution in ['covered_by_savings', 'carried_forward', 'none'])
            && (!('coveredBySavingsCents' in rem)
              || ('netDeficitCents' in rem && nonnegative(rem.coveredBySavingsCents)
                && rem.coveredBySavingsCents <= rem.netDeficitCents))
            && (!('uncoveredDeficitCents' in rem)
              || ('netDeficitCents' in rem && nonnegative(rem.uncoveredDeficitCents)
                && rem.uncoveredDeficitCents <= rem.netDeficitCents))
            && (!('coveredBySavingsCents' in rem && 'uncoveredDeficitCents' in rem)
              || rem.coveredBySavingsCents + rem.uncoveredDeficitCents == rem.netDeficitCents)
            && (!('closedAt' in rem) || rem.closedAt == null || rem.closedAt is timestamp)));
    }

    match /{document=**} {
      allow read, write: if false;
    }
    match /users/{userId} {
      function currentMarker(monthId, allowPastCatchup) {
        let parts = monthId.split('-');
        let low = request.time - duration.value(3, 'd');
        let high = request.time + duration.value(3, 'd');
        let key = int(parts[0]) * 12 + int(parts[1]);
        return (allowPastCatchup || key >= low.year() * 12 + low.month())
          && key <= high.year() * 12 + high.month();
      }
      function validPreviousClosure(previousId) {
        let path = /databases/$(database)/documents/users/$(userId)/months/$(previousId);
        let previous = get(path).data;
        let after = getAfter(path).data;
        return previous.closed == false && after.closed == true
          && validClosureRemainder(after.remainder, previous);
      }
      function previousMonthPendingClose(previousId, data) {
        // F5: el cursor puede avanzar al mes nuevo mientras el anterior sigue
        // abierto durante la ventana de gracia. Solo se admite si el perfil lo
        // marca como pendiente y el mes permanece abierto (sin cerrarlo aquí).
        let path = /databases/$(database)/documents/users/$(userId)/months/$(previousId);
        return exists(path) && get(path).data.closed == false
          && getAfter(path).data.closed == false
          && data.get('pendingCloseMonthId', null) == previousId;
      }
      function previousMonthProcessed(previousId, data) {
        let path = /databases/$(database)/documents/users/$(userId)/months/$(previousId);
        return !exists(path) || get(path).data.closed == true
          || validPreviousClosure(previousId)
          || previousMonthPendingClose(previousId, data);
      }
      function validNewProfileFields(data) {
        // Validate only the F5 fields when present/changed; untouched legacy
        // fields remain compatible with older clients.
        let changed = data.diff(resource.data).affectedKeys();
        return (!changed.hasAny(['pendingCloseMonthId'])
            || data.get('pendingCloseMonthId', null) == null
            || (data.pendingCloseMonthId is string
              && data.pendingCloseMonthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
              && (!exists(/databases/$(database)/documents/users/$(userId)/months/$(data.pendingCloseMonthId))
                || get(/databases/$(database)/documents/users/$(userId)/months/$(data.pendingCloseMonthId)).data.closed == false)))
          && (!changed.hasAny(['unseenClosedMonthId'])
            || data.get('unseenClosedMonthId', null) == null
            || (data.unseenClosedMonthId is string
              && data.unseenClosedMonthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
              && exists(/databases/$(database)/documents/users/$(userId)/months/$(data.unseenClosedMonthId))))
          && (!changed.hasAny(['closingMode'])
            || data.get('closingMode', 'auto_grace') == 'auto_grace')
          && (!changed.hasAny(['timeZone'])
            || (data.timeZone is string && data.timeZone.size() > 0 && data.timeZone.size() <= 100))
          && (!changed.hasAny(['closingPolicy'])
            || (data.closingPolicy is map
              && data.closingPolicy.keys().hasOnly(['necesidadSurplus', 'necesidadRolloverCapCents', 'ocioSurplus'])
              && data.closingPolicy.necesidadSurplus in ['rollover_all', 'sweep_to_savings', 'rollover_capped']
              && data.closingPolicy.ocioSurplus in ['sweep_to_savings', 'rollover_all']
              && (!('necesidadRolloverCapCents' in data.closingPolicy)
                || nonnegative(data.closingPolicy.necesidadRolloverCapCents))));
      }
      function validLastClosedMonth(data) {
        let previousId = resource.data.get('lastClosedMonth', null);
        let nextId = data.get('lastClosedMonth', null);
        let cleaning = resource.data.get('dataDeletionMode', '') in ['reset', 'delete-account'];
        // Unchanged legacy fields and all other profile fields stay outside this validation.
        return !data.diff(resource.data).affectedKeys().hasAny(['lastClosedMonth'])
          || (data.keys().hasAll(['lastClosedMonth'])
            && (nextId == null
              ? cleaning
              : (!cleaning && nextId is string && nextId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
                && currentMarker(nextId, previousId != null)
                && (previousId == null || (previousId is string
                  && previousId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$') && nextId > previousId))
                && existsAfter(/databases/$(database)/documents/users/$(userId)/months/$(nextId))
                && (previousId == null || previousMonthProcessed(previousId, data)))));
      }
      function validSavingsTotal(data, creating) {
        return (creating
            ? !('savingsTotalCents' in data)
            : !data.diff(resource.data).affectedKeys().hasAny(['savingsTotalCents']))
          || nonnegative(data.savingsTotalCents);
      }
      function validDistribution(data, creating) {
        return (creating
            ? !('distribution' in data)
            : !data.diff(resource.data).affectedKeys().hasAny(['distribution']))
          || percentage(data.distribution);
      }
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && request.resource.data.lastClosedMonth == null
                    && validSavingsTotal(request.resource.data, true)
                    && validDistribution(request.resource.data, true)
                    && request.resource.data.get('pendingCloseMonthId', null) == null
                    && request.resource.data.get('unseenClosedMonthId', null) == null
                    && request.resource.data.get('closingMode', 'auto_grace') == 'auto_grace'
                    && (!('timeZone' in request.resource.data)
                      || (request.resource.data.timeZone is string && request.resource.data.timeZone.size() > 0 && request.resource.data.timeZone.size() <= 100))
                    && (!('closingPolicy' in request.resource.data)
                      || (request.resource.data.closingPolicy is map
                        && request.resource.data.closingPolicy.keys().hasOnly(['necesidadSurplus', 'necesidadRolloverCapCents', 'ocioSurplus'])
                        && request.resource.data.closingPolicy.necesidadSurplus in ['rollover_all', 'sweep_to_savings', 'rollover_capped']
                        && request.resource.data.closingPolicy.ocioSurplus in ['sweep_to_savings', 'rollover_all']
                        && (!('necesidadRolloverCapCents' in request.resource.data.closingPolicy)
                          || nonnegative(request.resource.data.closingPolicy.necesidadRolloverCapCents))));
      allow update: if isOwner(userId) && resource.data is map
        ? (validLastClosedMonth(request.resource.data)
          && validSavingsTotal(request.resource.data, false)
          && validDistribution(request.resource.data, false)
          && validNewProfileFields(request.resource.data))
        : false;
      allow delete: if isOwner(userId)
                    && resource.data.get('dataDeletionMode', '') == 'delete-account';
    }
    match /users/{userId}/months/{monthId} {
      function pair(value) {
        return value is map && value.keys().hasOnly(['necesidad', 'ocio'])
          && nonnegative(value.necesidad) && nonnegative(value.ocio);
      }
      // UTC +/- 3 days covers UTC-12..UTC+14 plus two days of clock margin,
      // or intermediate catch-up months created atomically while advancing lastClosedMonth.
      function currentMonth() {
        let parts = monthId.split('-');
        let low = request.time - duration.value(3, 'd');
        let high = request.time + duration.value(3, 'd');
        let key = int(parts[0]) * 12 + int(parts[1]);
        let userPath = /databases/$(database)/documents/users/$(userId);
        let prevMarker = get(userPath).data.get('lastClosedMonth', null);
        return monthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && key <= high.year() * 12 + high.month()
          && (key >= low.year() * 12 + low.month()
            || (prevMarker is string && monthId > prevMarker
              && getAfter(userPath).data.get('lastClosedMonth', null) == monthId));
      }
      function inheritedCaps(data) {
        let previousId = get(/databases/$(database)/documents/users/$(userId)).data.lastClosedMonth;
        let previousPath = /databases/$(database)/documents/users/$(userId)/months/$(previousId);
        let previous = get(previousPath).data;
        let after = getAfter(previousPath).data;
        return previousId is string && previousId < monthId
          && previous.closed == false && after.closed == true
          && data.borrowedCapsCents.necesidad == borrowedRemainder(previous, 'necesidad')
          && data.borrowedCapsCents.ocio == borrowedRemainder(previous, 'ocio')
          && (('ocioToNextMonthCents' in after.remainder
              && data.capsCents.ocio == after.remainder.ocioToNextMonthCents + data.borrowedCapsCents.ocio)
            || (!('ocioToNextMonthCents' in after.remainder)
              && data.capsCents.ocio == data.borrowedCapsCents.ocio))
          && (('necesidadToNextMonthCents' in after.remainder
              && data.capsCents.necesidad == after.remainder.necesidadToNextMonthCents + data.borrowedCapsCents.necesidad)
            || (after.remainder.keys().hasOnly(['ocioToAhorroCents'])
              && after.remainder.ocioToAhorroCents == legacyOcio(previous)
              && data.capsCents.necesidad == legacyNec(previous) + data.borrowedCapsCents.necesidad));
      }
      function validNewMonth(data) {
        return currentMonth()
          && data.keys().hasOnly(['totalIncomeCents', 'distribution', 'capsCents', 'spentCents',
            'borrowedCapsCents', 'loanFundedSpentCents', 'ahorroContributedCents', 'incomeCount',
            'distributedIncomeCount', 'closed', 'createdAt', 'inheritedNecesidadCents',
            'inheritedOcioCents', 'carriedDeficitCents'])
          && percentage(data.distribution) && pair(data.capsCents) && pair(data.borrowedCapsCents)
          && (!('carriedDeficitCents' in data) || nonnegative(data.carriedDeficitCents))
          && (!('inheritedNecesidadCents' in data)
            || (nonnegative(data.inheritedNecesidadCents)
              && data.inheritedNecesidadCents == data.capsCents.necesidad - data.borrowedCapsCents.necesidad))
          && (!('inheritedOcioCents' in data)
            || (nonnegative(data.inheritedOcioCents)
              && data.inheritedOcioCents == data.capsCents.ocio - data.borrowedCapsCents.ocio))
          && (!('distributedIncomeCount' in data) || (isIntValue(data.distributedIncomeCount) && data.distributedIncomeCount == 0))
          && isIntValue(data.totalIncomeCents) && data.totalIncomeCents == 0
          && isIntValue(data.incomeCount) && data.incomeCount == 0
          && isIntValue(data.ahorroContributedCents) && data.ahorroContributedCents == 0
          && data.spentCents == {'necesidad': 0, 'ocio': 0}
          && data.loanFundedSpentCents == {'necesidad': 0, 'ocio': 0}
          && data.closed == false && data.createdAt == request.time
          && ((data.capsCents == {'necesidad': 0, 'ocio': 0}
              && data.borrowedCapsCents == {'necesidad': 0, 'ocio': 0})
            || inheritedCaps(data));
      }
      // Nested diffs preserve untouched legacy entries such as capsCents.ahorro.
      function changedPair(data, field) {
        let next = data.get(field, null);
        let changed = next.diff(resource.data.get(field, {})).affectedKeys();
        return next is map && (!(field in resource.data) ? pair(next) : changed.hasOnly(['necesidad', 'ocio']))
          && (!changed.hasAny(['necesidad']) || nonnegative(next.get('necesidad', null)))
          && (!changed.hasAny(['ocio']) || nonnegative(next.get('ocio', null)));
      }
      function changedAmounts(data, changed) {
        return (!changed.hasAny(['totalIncomeCents']) || nonnegative(data.get('totalIncomeCents', null)))
          && (!changed.hasAny(['incomeCount']) || nonnegative(data.get('incomeCount', null)))
          && (!changed.hasAny(['distributedIncomeCount']) || nonnegative(data.get('distributedIncomeCount', null)))
          && (!changed.hasAny(['ahorroContributedCents']) || nonnegative(data.get('ahorroContributedCents', null)))
          && (!changed.hasAny(['directSavingsCents']) || nonnegative(data.get('directSavingsCents', null)))
          && (!changed.hasAny(['inheritedNecesidadCents']) || nonnegative(data.get('inheritedNecesidadCents', null)))
          && (!changed.hasAny(['inheritedOcioCents']) || nonnegative(data.get('inheritedOcioCents', null)))
          && (!changed.hasAny(['carriedDeficitCents']) || nonnegative(data.get('carriedDeficitCents', null)))
          && (!changed.hasAny(['capsCents']) || changedPair(data, 'capsCents'))
          && (!changed.hasAny(['spentCents']) || changedPair(data, 'spentCents'))
          && (!changed.hasAny(['borrowedCapsCents']) || changedPair(data, 'borrowedCapsCents'))
          && (!changed.hasAny(['loanFundedSpentCents']) || changedPair(data, 'loanFundedSpentCents'));
      }
      function validMonthUpdate(data) {
        let changed = data.diff(resource.data).affectedKeys();
        return changed.hasOnly(['distribution', 'totalIncomeCents', 'capsCents', 'spentCents',
            'borrowedCapsCents', 'loanFundedSpentCents', 'ahorroContributedCents',
            'directSavingsCents', 'inheritedNecesidadCents', 'inheritedOcioCents', 'carriedDeficitCents', 'incomeCount',
            'distributedIncomeCount', 'closed', 'remainder'])
          && changedAmounts(data, changed)
          && (!changed.hasAny(['distribution'])
            || (percentage(data.distribution)
              && (resource.data.get('distributedIncomeCount', resource.data.totalIncomeCents > 0 ? 1 : 0) == 0
                || (changed.hasOnly(['distribution'])
                  && data.distribution == getAfter(/databases/$(database)/documents/users/$(userId)).data.distribution))))
          && ((resource.data.closed == false
              && ((data.closed == false && !changed.hasAny(['remainder']))
                || (data.closed == true && changed.hasOnly(['closed', 'remainder']) && validClosureRemainder(data.remainder, resource.data))))
            || (resource.data.closed == true && !('remainder' in resource.data)
              && changed.hasOnly(['remainder']) && validClosureRemainder(data.remainder, resource.data)));
      }
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && !isDeletingUserData(userId)
        ? validNewMonth(request.resource.data) : false;
      allow update: if isOwner(userId) && !isDeletingUserData(userId)
        ? validMonthUpdate(request.resource.data) : false;
      allow delete: if isDeletingUserData(userId);
    }
    match /users/{userId}/months/{monthId}/transactions/{txId} {
      function openMonth() {
        let path = /databases/$(database)/documents/users/$(userId)/months/$(monthId);
        return get(path).data.closed == false && getAfter(path).data.closed == false;
      }
      function text(value, limit) {
        return value is string && value.size() > 0 && value.size() <= limit;
      }
      function optionalText(data, field, limit) {
        return !(field in data) || (data[field] is string && data[field].size() <= limit);
      }
      function graceOpenPreviousMonth() {
        // F5: el mes inmediato anterior sigue abierto y marcado como pendiente
        // solo durante la ventana de gracia. Se acepta cualquier día de ese mes
        // (el cliente lo cierra en cuanto vence la gracia).
        let userPath = /databases/$(database)/documents/users/$(userId);
        let monthPath = /databases/$(database)/documents/users/$(userId)/months/$(monthId);
        return get(userPath).data.get('pendingCloseMonthId', null) == monthId
          && get(monthPath).data.closed == false
          && getAfter(monthPath).data.closed == false;
      }
      function validDate(value) {
        let parts = value.split('-');
        let year = int(parts[0]);
        let month = int(parts[1]);
        let day = int(parts[2]);
        let date = timestamp.date(year, month, day);
        let low = request.time - duration.value(3, 'd');
        let high = request.time + duration.value(3, 'd');
        let key = year * 12 + month;
        return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && parts[0] + '-' + parts[1] == monthId
          && date.year() == year && date.month() == month && date.day() == day
          && (key >= low.year() * 12 + low.month() || graceOpenPreviousMonth())
          && key <= high.year() * 12 + high.month()
          && date <= high;
      }
      function validTags(tags) {
        return tags is list && tags.size() <= 5
          && (tags.size() < 1 || text(tags[0], 24))
          && (tags.size() < 2 || text(tags[1], 24))
          && (tags.size() < 3 || text(tags[2], 24))
          && (tags.size() < 4 || text(tags[3], 24))
          && (tags.size() < 5 || text(tags[4], 24));
      }
      function validSplit(data) {
        let split = data.distribution;
        return split is map && split.keys().hasOnly(['necesidad', 'ocio', 'ahorro'])
          && nonnegative(split.necesidad) && nonnegative(split.ocio) && nonnegative(split.ahorro)
          && split.necesidad + split.ocio + split.ahorro == data.amountCents;
      }
      function newIncomeSplit(data) {
        let percentages = get(/databases/$(database)/documents/users/$(userId)/months/$(monthId)).data.distribution;
        return validSplit(data) && (data.get('isDirectSavings', false)
          ? data.distribution == {'necesidad': 0, 'ocio': 0, 'ahorro': data.amountCents}
          : (data.distribution.necesidad == math.floor(data.amountCents * percentages.necesidad / 100.0)
            && data.distribution.ocio == math.floor(data.amountCents * percentages.ocio / 100.0)));
      }
      function editedIncomeSplit(data) {
        let old = resource.data;
        return validSplit(data) && (old.get('isDirectSavings', false)
          ? data.distribution == {'necesidad': 0, 'ocio': 0, 'ahorro': data.amountCents}
          : (old.amountCents > 0
            && data.distribution.necesidad == math.floor(data.amountCents * (old.distribution.necesidad / float(old.amountCents)))
            && data.distribution.ocio == math.floor(data.amountCents * (old.distribution.ocio / float(old.amountCents)))));
      }
      function pairedText(data, first, second) {
        return (first in data) || (second in data)
          ? text(data.get(first, null), 200) && text(data.get(second, null), 200)
          : true;
      }
      function loanPath(id) {
        return /databases/$(database)/documents/users/$(userId)/loans/$(id);
      }
      function cardPath(id) {
        return /databases/$(database)/documents/users/$(userId)/creditCards/$(id);
      }
      function cardDelta(data, delta) {
        let path = cardPath(data.creditCardId);
        return getAfter(path).data.currentDebtCents == get(path).data.currentDebtCents + delta
          && getAfter(path).data.currentDebtCents >= 0;
      }
      function unconfirmedCard(data, date) {
        let card = get(cardPath(data.creditCardId)).data;
        return data.transactionDate > card.get('lastStatementClosingDate', '')
          && date > card.get('lastStatementClosingDate', '');
      }
      function fundedDelta(data, delta) {
        let path = loanPath(data.fundedByLoanId);
        let old = get(path).data;
        let next = getAfter(path).data;
        let balances = old.get('borrowedAvailableByCategory',
          old.destinationCategory == 'necesidad'
            ? {'necesidad': old.borrowedAvailableCents, 'ocio': 0}
            : {'necesidad': 0, 'ocio': old.borrowedAvailableCents});
        let other = data.category == 'necesidad' ? 'ocio' : 'necesidad';
        // Spending can consume the shared fund across both categories. Reversal
        // restores to the expense category, as transactionService does.
        let selected = balances[data.category] + delta;
        let overflow = selected < 0 ? selected : 0;
        return next.borrowedAvailableCents == old.borrowedAvailableCents + delta
          && next.borrowedAvailableByCategory[data.category] == (selected < 0 ? 0 : selected)
          && next.borrowedAvailableByCategory[other] == balances[other] + overflow;
      }
      function newLoanPayment(data) {
        let path = /databases/$(database)/documents/users/$(userId)/loans/$(data.loanId)/payments/$(data.loanPaymentId);
        let payment = getAfter(path).data;
        return !exists(path) && payment.transactionId == txId && payment.monthId == monthId
          && payment.amountCents == data.amountCents && payment.paymentDate == data.transactionDate
          && payment.sourceCategory == data.category;
      }
      function newCardCharge(data) {
        let path = /databases/$(database)/documents/users/$(userId)/creditCards/$(data.creditCardId)/statements/$(data.creditCardStatementId);
        let statement = getAfter(path).data;
        return !exists(path) && statement.interestTransactionId == txId
          && statement.recordedMonthId == monthId && statement.interestChargesCents == data.amountCents;
      }
      function expenseLinks(data) {
        return pairedText(data, 'fundedByLoanId', 'fundedByLoanName')
          && pairedText(data, 'loanId', 'loanPaymentId')
          && pairedText(data, 'creditCardId', 'creditCardName')
          && pairedText(data, 'creditCardStatementId', 'creditCardChargeKind')
          && ('goalId' in data ? (text(data.goalId, 200) && data.category == 'ahorro'
